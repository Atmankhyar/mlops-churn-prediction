name: MLflow Project - Churn Prediction

entry_points:
  train:
    parameters:
      model_type:
        type: str
        default: random_forest
      dataset_version:
        type: str
        default: v1.0
      data_path:
        type: str
        default: data/raw
    command: >
      python scripts/train_local.py
        --model {model_type}
        --version {dataset_version}
